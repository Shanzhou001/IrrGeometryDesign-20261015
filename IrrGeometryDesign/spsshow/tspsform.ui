 <connections>
  <connection>
   <sender>saveAction</sender>
   <!-- add by shanzhou in 2026/10/15 -->
   <signal>triggered()</signal>
   <receiver>TSPSForm</receiver>
   <slot>saveSPS()</slot>
   <hints>
    <hint type="sourcelabel">
     <x>-1</x>
     <y>-1</y>
    </hint>
    <hint type="destinationlabel">
     <x>20</x>
     <y>20</y>
    </hint>
   </hints>
  </connection>
  <connection>
   <sender>zoomAction</sender>
   <signal>triggered()</signal>
   <receiver>TSPSForm</receiver>
   <slot>zoom()</slot>
   <hints>
    <hint type="sourcelabel">
     <x>-1</x>
     <y>-1</y>
    </hint>
    <hint type="destinationlabel">
     <x>20</x>
     <y>20</y>
    </hint>
   </hints>
  </connection>
  <connection>
   <sender>mScaleBox</sender>
   <signal>valueChanged(int)</signal>
   <receiver>TSPSForm</receiver>
   <slot>onZoomChanged(int)</slot>
   <hints>
    <hint type="sourcelabel">
     <x>20</x>
     <y>20</y>
    </hint>
    <hint type="destinationlabel">
     <x>20</x>
     <y>20</y>
    </hint>
   </hints>
  </connection>
  <connection>
