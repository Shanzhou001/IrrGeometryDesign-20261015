\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Frozen v4 search at $B=600$: mean coherence and marginal 95\% bootstrap intervals across 20 seeds. Uniform counts are 38/64/90 of 128; physical counts are 20/30/40 of 59. All methods optimize the same unpenalized objective within a group. The physical interpretation remains conditional on header geometry.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:search}{{1}{6}{Frozen v4 search at $B=600$: mean coherence and marginal 95\% bootstrap intervals across 20 seeds. Uniform counts are 38/64/90 of 128; physical counts are 20/30/40 of 59. All methods optimize the same unpenalized objective within a group. The physical interpretation remains conditional on header geometry}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces V5 paired coherence differences at $B=300$, ten seeds per group. U/P denote uniform/physical coordinates. Final-score differences and differences truncated to common actual evaluation counts are distinct. The Adaptive--NoRecycle common prefixes are exactly identical. Error bars are marginal bootstrap intervals; the 42-test Holm family has no significant contrasts.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:budget}{{2}{6}{V5 paired coherence differences at $B=300$, ten seeds per group. U/P denote uniform/physical coordinates. Final-score differences and differences truncated to common actual evaluation counts are distinct. The Adaptive--NoRecycle common prefixes are exactly identical. Error bars are marginal bootstrap intervals; the 42-test Holm family has no significant contrasts}{figure.2}{}}
